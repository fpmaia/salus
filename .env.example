# Copie para .env (cp .env.example .env). Valores abaixo são apenas para desenvolvimento local.

# Porta do Postgres do docker compose no host (5433 para não conflitar com outro Postgres local).
DB_PORT=5433

# Papel da aplicação (sem BYPASSRLS): Next.js, worker, Better Auth e seed.
DATABASE_URL=postgres://salus_app:salus_app_dev@localhost:5433/salus
# Papel dono das tabelas: somente migrations (npm run db:migrate / db:generate).
DATABASE_MIGRATOR_URL=postgres://salus_owner:salus_owner_dev@localhost:5433/salus

# Banco usado pelos testes de integração (recriado a cada execução).
TEST_DATABASE_URL=postgres://salus_app:salus_app_dev@localhost:5433/salus_test
TEST_DATABASE_MIGRATOR_URL=postgres://salus_owner:salus_owner_dev@localhost:5433/salus_test

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# URL pública usada nos links enviados aos pacientes (worker e app).
APP_URL=http://localhost:3000
# Segredo dos links assinados do paciente. Obrigatório em produção (sem fallback). Gere com: openssl rand -base64 32
LINKS_SECRET=troque-por-outro-segredo-aleatorio-de-32-caracteres

# WhatsApp: "console" só registra no log do worker; "meta" envia pela WhatsApp Cloud API.
WHATSAPP_PROVIDER=console
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Templates aprovados no WhatsApp Manager (corpo com parâmetros na ordem documentada em src/server/provider.ts).
# WHATSAPP_TEMPLATE_AGENDAMENTO=lembrete_agendamento
# WHATSAPP_TEMPLATE_RESERVA=lembrete_reserva
# WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# Chave para cifrar segredos de integrações no banco (ex.: token da Focus NFe), 32 bytes em base64.
# Gere com: openssl rand -base64 32. Obrigatória em produção; em dev, se ausente, deriva do BETTER_AUTH_SECRET.
# Os três segredos (BETTER_AUTH_SECRET, LINKS_SECRET, SECRETS_KEY) devem ser diferentes.
SECRETS_KEY=

# Asaas da PLATAFORMA (cobrança do SaaS aos espaços). "simulado" não cobra de verdade.
ASAAS_AMBIENTE=simulado
# ASAAS_API_KEY=
# Token que o Asaas envia no header asaas-access-token do webhook /api/webhooks/asaas/plataforma
# ASAAS_WEBHOOK_TOKEN=

# Anexos do prontuário (S3 compatível). Em dev: docker compose up -d s3
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=salus-anexos
S3_ACCESS_KEY=salus
S3_SECRET_KEY=salus-s3-dev
S3_REGIAO=us-east-1

# Login de demonstração (só contas do seed *@alfa|beta.salus.dev). Sempre ligado em dev; em produção só com true.
# SALUS_DEMO=false

# Superadmin da plataforma (npm run plataforma:promover).
# PLATFORM_OWNER_EMAILS=

# E-mail transacional (confirmação de conta, redefinição de senha, convites).
# "console" só registra no log (dev); em produção use "resend" (https://resend.com, domínio verificado).
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Salus <nao-responda@seu-dominio.com.br>

# Captcha (Cloudflare Turnstile) no cadastro, na recuperação de senha e no agendamento online.
# Sem as chaves fica desligado (dev); em produção são obrigatórias. https://dash.cloudflare.com → Turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Rate limit: cabeçalho com o IP real do cliente, sobrescrito pelo reverse proxy (Caddy: X-Real-IP).
# IP_HEADER=x-real-ip
# Tentativas de login por minuto e por IP (padrão 5).
# AUTH_LOGIN_MAX_POR_MINUTO=5
